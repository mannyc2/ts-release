{
  "project": { "repository": "mannyc2/ts-release" },
  "versionFrom": "manifest",
  "npmPackage": {
    "path": ".",
    "build": {
      "run": ["bun", "--no-env-file", "--no-install", "run", "build"],
      "outputRoots": ["dist"]
    }
  },
  "builds": [
    {
      "builder": "bun",
      "id": "cli",
      "entry": "apps/release-ts/src/cli/main.ts",
      "targets": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64"],
      "output": ".release/artifacts/ts-release-{version}-{targetTriple}{ext}",
      "binary": "ts-release"
    }
  ],
  "preparations": [
    {
      "kind": "artifact",
      "id": "agents",
      "run": ["bun", "run", "apps/ts-release-agents/src/build.ts", "--archives-only"],
      "collection": {
        "root": ".release/agents/archives",
        "artifactKind": "archive",
        "pathSuffix": ".zip",
        "mediaType": "application/zip",
        "cardinality": { "kind": "bounded", "minimum": 2, "maximum": 2 }
      }
    }
  ],
  "archives": [
    {
      "id": "cli-linux-x64",
      "ids": ["cli-linux-x64"],
      "nameTemplate": "ts-release_{version}_linux-x64",
      "formats": ["tar.gz", "zip"]
    },
    {
      "id": "cli-linux-arm64",
      "ids": ["cli-linux-arm64"],
      "nameTemplate": "ts-release_{version}_linux-arm64",
      "formats": ["tar.gz", "zip"]
    },
    {
      "id": "cli-darwin-x64",
      "ids": ["cli-darwin-x64"],
      "nameTemplate": "ts-release_{version}_darwin-x64",
      "formats": ["tar.gz", "zip"]
    },
    {
      "id": "cli-darwin-arm64",
      "ids": ["cli-darwin-arm64"],
      "nameTemplate": "ts-release_{version}_darwin-arm64",
      "formats": ["tar.gz", "zip"]
    }
  ],
  "checksum": { "algorithm": "sha256" },
  "publish": {
    "npm": {
      "registry": "https://registry.npmjs.org/",
      "authentication": {
        "strategy": "trusted-publishing",
        "attestation": {
          "provider": "github-actions",
          "runner": "github-hosted",
          "repository": "mannyc2/ts-release",
          "workflow": "release.yml",
          "workflowRef": "refs/heads/main",
          "allowedAction": "npm-publish-direct"
        }
      },
      "access": "public",
      "provenance": "automatic"
    },
    "github": {
      "tokenEnv": "GITHUB_TOKEN",
      "draft": false,
      "prerelease": false,
      "ids": [
        "cli-linux-x64-tar-gz", "cli-linux-x64-zip",
        "cli-linux-arm64-tar-gz", "cli-linux-arm64-zip",
        "cli-darwin-x64-tar-gz", "cli-darwin-x64-zip",
        "cli-darwin-arm64-tar-gz", "cli-darwin-arm64-zip",
        "checksum-digests"
      ],
      "collections": [{
        "collection": "agents",
        "artifactKind": "archive",
        "pathSuffix": ".zip",
        "mediaType": "application/zip",
        "cardinality": { "kind": "bounded", "minimum": 2, "maximum": 2 }
      }]
    }
  }
}
