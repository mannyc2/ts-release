{
  "schemaVersion": "rewrite-config-boundary/v1",
  "corePlanInput": {
    "requiredFields": ["config", "workspace"],
    "optionalFields": [],
    "configType": "strict-json-compatible-value",
    "workspaceType": "existing-absolute-realpath-directory",
    "forbiddenFields": ["configPath", "encoding", "parser", "sourceLabel"]
  },
  "jsonCompatibility": {
    "accepted": ["null", "boolean", "string", "safe-integer", "dense-array", "plain-object"],
    "rejected": [
      "function",
      "symbol",
      "bigint",
      "Date",
      "class-instance",
      "undefined",
      "non-finite-number",
      "float",
      "negative-zero",
      "sparse-array",
      "cycle"
    ]
  },
  "cliWorkspaceSelection": [
    {
      "id": "explicit-root",
      "root": "./workspace",
      "configPath": "/other/release.json",
      "cwd": "/invocation",
      "selected": "/invocation/workspace"
    },
    {
      "id": "absolute-config",
      "root": null,
      "configPath": "/workspace/config/release.json",
      "cwd": "/invocation",
      "selected": "/workspace/config"
    },
    {
      "id": "relative-config",
      "root": null,
      "configPath": "config/release.json",
      "cwd": "/invocation",
      "selected": "/invocation"
    }
  ],
  "directWorkspaceCases": [
    { "id": "empty", "input": "", "result": "reject" },
    { "id": "relative", "input": "./workspace", "result": "reject" },
    { "id": "absolute-directory", "input": "/workspace", "result": "realpath" },
    { "id": "absolute-symlink", "input": "/workspace-link", "result": "same-realpath" }
  ],
  "actionBoundary": {
    "rootSource": ["GITHUB_WORKSPACE", "process.cwd"],
    "configEncoding": "JSON",
    "readCount": 1,
    "workspaceSelectionFromConfig": false,
    "acceptedConfigPaths": ["relative-contained", "absolute-contained"],
    "rejectedConfigPaths": ["outside", "parent-traversal"]
  },
  "identityNeutralInputs": [
    "config-source-path",
    "config-source-label",
    "encoding",
    "whitespace",
    "object-key-insertion-order",
    "workspace-root"
  ],
  "applyInput": {
    "accepted": ["acceptedPlanBytes", "planId", "runInput", "workspace"],
    "forbidden": ["config", "configPath", "encoding", "parser"]
  },
  "baselineTopLevelFields": [
    "$schema",
    "project",
    "versionFrom",
    "builds",
    "npmPackage",
    "pypiWheel",
    "artifacts",
    "archives",
    "checksum",
    "catalogs",
    "hooks",
    "publish",
    "retry",
    "evidence"
  ],
  "presetOwnership": {
    "homebrew": {
      "productOwned": ["schema", "profile", "renderer", "response-shape", "authority", "credential-slot-class"],
      "configOwned": ["release-facts", "artifact-ids", "repository", "path", "name", "supported-options"]
    },
    "scoop": {
      "productOwned": ["schema", "profile", "renderer", "response-shape", "authority", "credential-slot-class"],
      "configOwned": ["release-facts", "artifact-ids", "repository", "path", "name", "supported-options"]
    },
    "genericCatalogEscapeHatch": "catalogs[].content"
  },
  "fixtures": [
    "test/fixtures/rewrite/config-boundary/homebrew.json",
    "test/fixtures/rewrite/config-boundary/scoop.json",
    "test/fixtures/rewrite/config-boundary/generic-catalog.json",
    "test/fixtures/rewrite/config-boundary/portable-multi-target.json"
  ],
  "activation": {
    "plan173": "contract-only",
    "plan174": ["json-compatible-input", "direct-parsed-equivalence", "no-file-semantics", "no-profile-definition"],
    "plan177": ["direct-workspace", "cli-file-boundary", "action-file-boundary", "runtime-configPath-rejection"]
  }
}
