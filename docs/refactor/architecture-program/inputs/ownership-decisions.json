doption records have no exported strict codec, ts-release owns a strict versioned durable adoption envelope and reverifies content. It preserves entry modes, symlinks, and shared content identity and rejects duplicate logical names, unsafe traversal, narrowing, mutable-path identity, and aliased mutable bytes. The exact packed contract remains blocked on terminal Plan 004 reconciliation.","dependentGateIds":["GM03-construction-boundaries","GT07-lossless-effect-build-file-tree-adoption"],"externalEvidenceIds":["EB01-generated-contract","EB02-generated-public-api"],"id":"OD08-hashed-file-tree-adoption","ownerId":"architecture-program","requiredEvidence":["Exact effect-build/artifact-adoption@1 HashedFile, HashedTree, adoptFile, and adoptTree fields and hashes are reconciled from terminal Plan 004.","A packed clean consumer proves file, tree, shared-content, mode, symlink, duplicate-name, traversal, and mutation cases."],"sourceCoordinates":[{"_tag":"CurrentWholeFileSourceCoordinate","path":"advisor-plans/004-establish-effect-build-release-readiness.md","repositoryId":"ts-release","sha256":"ad84b8b021fec89fcc24aa6d285ebb0e3d39629b7aaa88f806a4f9940af16ef7"},{"_tag":"CurrentWholeFileSourceCoordinate","path":"advisor-plans/005-freeze-research-complete-system-contract.md","repositoryId":"ts-release","sha256":"f2af8b2b2a591e0e66ad18654d43a937a746b5f4dc5595e2e99cca96ab4aa965"},{"_tag":"CurrentWholeFileSourceCoordinate","path":"docs/refactor/research/artifact-model.md","repositoryId":"ts-release","sha256":"ff0056380d1484ae5cbb9eda7680955c53687a9939a9e77349926523c2990a14"},{"_tag":"CurrentWholeFileSourceCoordinate","path":"docs/refactor/research/artifact-storage.md","repositoryId":"ts-release","sha256":"c962c3735e155e2ea1f3e4792bde6d466acd46efc6d8e1acb5ddc3a53b227fdf"},{"_tag":"CurrentWholeFileSourceCoordinate","path":"docs/refactor/research/cross-repository-delivery.md","repositoryId":"ts-release","sha256":"b5d767fb1f67f00cc716da50a16258cb2056280d3e0f777a933809734abb7c0a"}],"