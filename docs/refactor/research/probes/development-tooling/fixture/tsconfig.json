{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "runEffectInsideEffect": "error",
          "tryCatchInEffectGen": "warning",
          "asyncFunction": "warning"
        }
      }
    ]
  },
  "include": ["./*.ts"]
}
