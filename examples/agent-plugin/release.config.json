{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "release-example-agent-plugin",
    "packageName": "release-example-agent-plugin",
    "version": "0.1.0",
    "commit": "example",
    "tag": "v0.1.0",
    "repository": "owner/agent-plugin"
  },
  "archives": [
    {
      "id": "plugin",
      "files": [
        "plugin/**"
      ],
      "formats": [
        "zip"
      ]
    }
  ],
  "checksum": {},
  "publish": {
    "github": {
      "repository": "owner/agent-plugin"
    }
  },
  "catalogs": [
    {
      "id": "codex-marketplace",
      "repository": "owner/codex-marketplace",
      "file": ".agents/plugins/marketplace.json",
      "content": [
        "{\n  \"name\": \"example-marketplace\",\n  \"interface\": {\n    \"displayName\": \"Example Marketplace\"\n  },\n  \"plugins\": [\n    {\n      \"name\": \"{name}\",\n      \"version\": \"{version}\",\n      \"source\": {\n        \"source\": \"git-subdir\",\n        \"url\": \"https://github.com/owner/agent-plugin\",\n        \"path\": \"./plugin\"\n      },\n      \"policy\": {\n        \"installation\": \"AVAILABLE\",\n        \"authentication\": \"ON_INSTALL\"\n      },\n      \"category\": \"Developer Tools\",\n      \"archiveSha256\": \"",
        {
          "fact": "sha256",
          "artifact": "plugin"
        },
        "\"\n    }\n  ]\n}\n"
      ]
    },
    {
      "id": "claude-marketplace",
      "repository": "owner/claude-marketplace",
      "file": ".claude-plugin/marketplace.json",
      "content": [
        "{\n  \"name\": \"example-marketplace\",\n  \"owner\": {\n    \"name\": \"owner\"\n  },\n  \"plugins\": [\n    {\n      \"name\": \"{name}\",\n      \"version\": \"{version}\",\n      \"source\": {\n        \"source\": \"git-subdir\",\n        \"url\": \"https://github.com/owner/agent-plugin\",\n        \"path\": \"./plugin\"\n      },\n      \"archiveUrl\": \"",
        {
          "fact": "downloadUrl",
          "artifact": "plugin"
        },
        "\",\n      \"sha256\": \"",
        {
          "fact": "sha256",
          "artifact": "plugin"
        },
        "\"\n    }\n  ]\n}\n"
      ]
    }
  ]
}
