{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "release-example-github",
    "packageName": "release-example-github",
    "version": "0.1.0",
    "tag": "v0.1.0"
  },
  "artifacts": [
    {
      "id": "archive",
      "path": "artifacts/release-example-github-0.1.0.tgz",
      "format": "tarball"
    }
  ],
  "publish": {
    "github": {
      "repository": "owner/repo",
      "tokenEnv": "GITHUB_TOKEN",
      "draft": true,
      "prerelease": false,
      "body": "Example GitHub release",
      "ids": ["archive"]
    }
  }
}
