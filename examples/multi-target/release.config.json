{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "release-example-multi-target",
    "packageName": "release-example-multi-target",
    "repository": "owner/release-example-multi-target",
    "version": "0.1.0",
    "tag": "v0.1.0"
  },
  "npmPackage": {
    "path": "."
  },
  "artifacts": [
    {
      "id": "archive",
      "path": "artifacts/release-example-multi-target-0.1.0.tgz",
      "format": "tarball"
    }
  ],
  "publish": {
    "github": {
      "repository": "owner/release-example-multi-target",
      "tokenEnv": "GITHUB_TOKEN",
      "draft": true,
      "prerelease": false,
      "body": "Example coordinated release",
      "ids": ["archive"]
    },
    "npm": {
      "registry": "https://registry.npmjs.org/",
      "authentication": {
        "strategy": "trusted-publishing",
        "attestation": {
          "provider": "github-actions",
          "runner": "github-hosted",
          "repository": "owner/release-example-multi-target",
          "workflow": "release.yml",
          "workflowRef": "refs/heads/main",
          "allowedAction": "npm-publish-direct"
        }
      },
      "access": "public",
      "provenance": "automatic"
    }
  }
}
