{
  "$schema": "https://mannyc2.github.io/ts-release/schema/release-config.schema.json",
  "project": {
    "name": "@scope/portable-example",
    "packageName": "@scope/portable-example",
    "repository": "owner/portable-example",
    "version": "0.1.0",
    "commit": "abc123",
    "tag": "v0.1.0",
    "description": "Portable CLI distribution for @scope/portable-example",
    "summary": "Portable CLI wrapper for @scope/portable-example.",
    "homepage": "https://github.com/owner/portable-example",
    "license": "MIT"
  },
  "npmPackage": {
    "path": "."
  },
  "builds": [
    {
      "builder": "bun",
      "id": "cli",
      "entry": "src/cli.ts",
      "targets": [
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64",
        "windows-x64"
      ],
      "output": "artifacts/portable-example-{version}-{targetTriple}{ext}",
      "binaryName": "portable-example",
      "installPath": "bin/portable-example"
    }
  ],
  "pypiWheel": {
    "packageName": "portable-example",
    "moduleName": "portable_example",
    "consoleScript": "portable-example",
    "requiresPython": ">=3.8",
    "wheels": [
      {
        "id": "pypi-wheel-linux-x64",
        "path": "artifacts/portable_example-{version}-py3-none-manylinux2014_x86_64.whl",
        "wheelTag": "py3-none-manylinux2014_x86_64",
        "binaries": [
          {
            "os": "linux",
            "arch": "x64",
            "sourcePath": "artifacts/portable-example-{version}-linux-x64",
            "wheelPath": "portable_example/bin/portable-example-linux-x64"
          }
        ]
      },
      {
        "id": "pypi-wheel-linux-arm64",
        "path": "artifacts/portable_example-{version}-py3-none-manylinux2014_aarch64.whl",
        "wheelTag": "py3-none-manylinux2014_aarch64",
        "binaries": [
          {
            "os": "linux",
            "arch": "arm64",
            "sourcePath": "artifacts/portable-example-{version}-linux-arm64",
            "wheelPath": "portable_example/bin/portable-example-linux-arm64"
          }
        ]
      },
      {
        "id": "pypi-wheel-darwin-x64",
        "path": "artifacts/portable_example-{version}-py3-none-macosx_10_15_x86_64.whl",
        "wheelTag": "py3-none-macosx_10_15_x86_64",
        "binaries": [
          {
            "os": "darwin",
            "arch": "x64",
            "sourcePath": "artifacts/portable-example-{version}-darwin-x64",
            "wheelPath": "portable_example/bin/portable-example-darwin-x64"
          }
        ]
      },
      {
        "id": "pypi-wheel-darwin-arm64",
        "path": "artifacts/portable_example-{version}-py3-none-macosx_11_0_arm64.whl",
        "wheelTag": "py3-none-macosx_11_0_arm64",
        "binaries": [
          {
            "os": "darwin",
            "arch": "arm64",
            "sourcePath": "artifacts/portable-example-{version}-darwin-arm64",
            "wheelPath": "portable_example/bin/portable-example-darwin-arm64"
          }
        ]
      },
      {
        "id": "pypi-wheel-windows-x64",
        "path": "artifacts/portable_example-{version}-py3-none-win_amd64.whl",
        "wheelTag": "py3-none-win_amd64",
        "binaries": [
          {
            "os": "windows",
            "arch": "x64",
            "sourcePath": "artifacts/portable-example-{version}-windows-x64.exe",
            "wheelPath": "portable_example/bin/portable-example-windows-x64.exe"
          }
        ]
      }
    ]
  },
  "publish": {
    "npm": {
      "registry": "https://registry.npmjs.org",
      "packageName": "@scope/portable-example",
      "packagePath": ".",
      "trustedPublishing": {
        "workflow": "release.yml",
        "verifyPackageExists": true
      },
      "access": "public",
      "provenance": true
    },
    "github": {
      "repository": "owner/portable-example",
      "tokenEnv": "GH_TOKEN",
      "draft": true,
      "prerelease": false
    },
    "homebrew": {
      "repository": "owner/homebrew-portable-example",
      "formulaName": "portable-example",
      "formulaPath": ".release/generated/portable-example.rb",
      "ids": [
        "cli-darwin-arm64",
        "cli-darwin-x64"
      ]
    },
    "scoop": {
      "repository": "owner/scoop-portable-example",
      "manifestName": "portable-example",
      "manifestPath": ".release/generated/portable-example.json",
      "ids": [
        "cli-windows-x64"
      ]
    },
    "pypi": {
      "repositoryUrl": "https://upload.pypi.org/legacy/",
      "trustedPublishing": {
        "provider": "github-actions",
        "workflow": "release.yml",
        "publisherConfigured": true
      }
    }
  },
  "evidence": ".release/evidence/{version}"
}
