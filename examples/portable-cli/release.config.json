{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "@scope/portable-example",
    "packageName": "@scope/portable-example",
    "repository": "owner/portable-example",
    "version": "0.1.0",
    "tag": "v0.1.0"
  },
  "npmPackage": {
    "path": "."
  },
  "builds": [
    {
      "builder": "bun",
      "id": "cli",
      "entry": "src/cli.ts",
      "targets": [
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64"
      ],
      "output": "artifacts/portable-example-{version}-{targetTriple}{ext}",
      "binary": "portable-example"
    }
  ],
  "publish": {
    "npm": {
      "registry": "https://registry.npmjs.org/",
      "authentication": {
        "strategy": "trusted-publishing",
        "attestation": {
          "provider": "github-actions",
          "runner": "github-hosted",
          "repository": "owner/portable-example",
          "workflow": "release.yml",
          "workflowRef": "refs/heads/main",
          "allowedAction": "npm-publish-direct"
        }
      },
      "access": "public",
      "provenance": "automatic"
    },
    "github": {
      "repository": "owner/portable-example",
      "tokenEnv": "GITHUB_TOKEN",
      "draft": true,
      "prerelease": false,
      "body": "Portable CLI wrapper for @scope/portable-example."
    }
  }
}
