{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "@scope/portable-example",
    "packageName": "@scope/portable-example",
    "repository": "owner/portable-example",
    "version": "0.1.0",
    "commit": "abc123",
    "tag": "v0.1.0",
    "description": "Portable CLI distribution for @scope/portable-example",
    "summary": "Portable CLI wrapper for @scope/portable-example.",
    "homepage": "https://github.com/owner/portable-example",
    "license": "MIT"
  },
  "npmPackage": {
    "path": "."
  },
  "builds": [
    {
      "builder": "bun",
      "id": "cli",
      "entry": "src/cli.ts",
      "targets": [
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64",
        "windows-x64"
      ],
      "output": "artifacts/portable-example-{version}-{targetTriple}{ext}",
      "binaryName": "portable-example",
      "installPath": "bin/portable-example"
    }
  ],
  "publish": {
    "npm": {
      "registry": "https://registry.npmjs.org",
      "packageName": "@scope/portable-example",
      "packagePath": ".",
      "trustedPublishing": {
        "workflow": "release.yml",
        "verifyPackageExists": true
      },
      "access": "public",
      "provenance": true
    },
    "github": {
      "repository": "owner/portable-example",
      "tokenEnv": "GH_TOKEN",
      "draft": true,
      "prerelease": false
    }
  }
}
