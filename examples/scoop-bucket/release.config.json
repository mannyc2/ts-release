{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "release-example-scoop",
    "packageName": "release-example-scoop",
    "version": "0.1.0",
    "commit": "example",
    "tag": "v0.1.0",
    "description": "Example Scoop manifest for a release artifact",
    "homepage": "https://github.com/owner/release-example-scoop",
    "license": "MIT"
  },
  "artifacts": [
    {
      "id": "archive",
      "path": "artifacts/release-example-scoop-0.1.0.zip",
      "format": "zip"
    }
  ],
  "catalogs": [
    {
      "id": "scoop-manifest",
      "repository": "owner/scoop-bucket",
      "file": "bucket/release-example-scoop.json",
      "content": "{\"version\":\"{version}\",\"homepage\":\"https://github.com/owner/release-example-scoop\"}\n"
    }
  ]
}
