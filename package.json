{
  "name": "@ts-release-private/workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.14"
  },
  "dependencies": {},
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.107",
    "@effect/platform-node": "4.0.0-beta.107",
    "@sigstore/rekor-types": "5.0.0",
    "@types/content-type": "1.1.9",
    "@types/make-fetch-happen": "10.0.4",
    "@types/semver": "7.7.1",
    "bun-types": "1.3.14",
    "effect": "4.0.0-beta.107",
    "effect-build-apple": "0.6.3",
    "effect-build-archives": "0.6.3",
    "effect-build-bun": "0.6.3",
    "effect-build-deno": "0.6.3",
    "effect-build-esbuild": "0.6.3",
    "effect-build-nfpm": "0.6.3",
    "effect-build-node-sea": "0.6.3",
    "effect-build-python": "0.6.3",
    "effect-build-sbom": "0.6.3",
    "effect-build-windows": "0.6.3",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.107"
  },
  "scripts": {
    "check:architecture-schema": "bun run --cwd tools/architecture-program check && bun run --cwd tools/architecture-program test",
    "check:architecture-inputs": "bun run --cwd tools/architecture-program check:inputs",
    "check:architecture-program": "bun tools/architecture-lab/verify.mjs && bun tools/architecture-lab/project.ts --check && bun scripts/check-architecture-ancestry.ts && bun scripts/check-migration-execution.ts && bun scripts/check-architecture-budget.ts --accept-recorded-planning-variance",
    "check:launch-evidence": "bun scripts/check-launch-evidence.ts",
    "check:launch-closure": "bun scripts/check-launch-evidence.ts --require-closed",
    "check:packed-action": "bun scripts/check-packed-action.ts",
    "check:effect-build-integration": "bun scripts/check-effect-build-integration.ts",
    "build": "bun scripts/build.ts",
    "check": "bun scripts/check.ts",
    "test": "bun test ./test/reimplementation",
    "format": "bun prettier --write packages apps/action apps/self-release test/reimplementation scripts/build.ts scripts/check.ts",
    "build:delivery": "bun scripts/build-delivery.ts",
    "check:import-rules": "bun scripts/check-import-rules.ts",
    "check:package-exports": "bun scripts/check-package-exports.ts",
    "check:packed-kernel": "bun scripts/check-packed-kernel.ts",
    "check:portable": "bun run check && bun run check:production-api && bun run test && bun run check:migration && bun run check:import-rules && bun run check:package-exports && bun run check:packed-catalog",
    "check:production-api": "bun scripts/project-production-api.ts --check",
    "check:migration": "bun scripts/check-migration-execution.ts",
    "check:packed-npm": "bun scripts/check-packed-npm.ts",
    "check:native-npm-sigstore": "bun scripts/check-native-npm-sigstore.ts",
    "check:packed-pypi": "bun scripts/check-packed-npm.ts --pypi",
    "setup:native-python": "bun scripts/setup-native-python.ts",
    "check:packed-github": "bun scripts/check-packed-npm.ts --github --transports",
    "check:packed-catalog": "bun scripts/check-packed-npm.ts --catalog --transports",
    "setup:native-catalog": "bun scripts/setup-native-catalog.ts",
    "check:packed-external": "bun scripts/check-packed-external.ts",
    "setup:native-producers": "bun scripts/setup-native-producers.ts",
    "check:packed-artifacts": "bun scripts/check-packed-artifacts.ts",
    "check:packed-apple": "bun scripts/check-packed-apple.ts"
  }
}
