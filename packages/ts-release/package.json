{
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "name": "@mannyc1/ts-release",
  "bin": {
    "ts-release": "./dist/bin/ts-release.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/Bundle.d.ts",
      "import": "./dist/Bundle.js"
    },
    "./http": {
      "types": "./dist/Http.d.ts",
      "import": "./dist/Http.js"
    },
    "./effect-build": {
      "types": "./dist/EffectBuild.d.ts",
      "import": "./dist/EffectBuild.js"
    },
    "./git": {
      "types": "./dist/Git.d.ts",
      "import": "./dist/Git.js"
    },
    "./bun": {
      "types": "./dist/Bun.d.ts",
      "import": "./dist/Bun.js"
    },
    "./node": {
      "types": "./dist/Node.d.ts",
      "import": "./dist/Node.js"
    },
    "./apple": {
      "types": "./dist/Apple.d.ts",
      "import": "./dist/Apple.js"
    }
  },
  "dependencies": {
    "effect-build": "0.7.0",
    "undici": "8.10.1"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <4.1.0-0",
    "@effect/platform-node": ">=4.0.0-rc.108 <4.1.0-0",
    "@effect/platform-bun": ">=4.0.0-rc.108 <4.1.0-0",
    "effect-build-apple": "0.7.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "effect-build-apple": {
      "optional": true
    }
  }
}
