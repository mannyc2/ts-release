{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "title": "ts-release configuration",
  "description": "The authored configuration: the canonical shape with the facts a repository can observe made optional. ts-release resolves it against the repository during inspect, prepare, publish, or release.",
  "$ref": "#/$defs/AuthoredConfig",
  "$defs": {
    "AuthoredProject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "packageName": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "version": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "repository": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "packagePath": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "tag": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "notes": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "summary": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "homepage": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "license": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "tagTemplate": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CandidateBunBuild": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux-x64",
              "linux-arm64",
              "linux-x64-musl",
              "linux-arm64-musl",
              "darwin-x64",
              "darwin-arm64",
              "windows-x64",
              "windows-arm64"
            ]
          }
        },
        "output": {
          "type": "string"
        },
        "binary": {
          "type": "string"
        },
        "builder": {
          "type": "string",
          "enum": [
            "bun"
          ]
        },
        "entry": {
          "type": "string"
        },
        "binaryName": {
          "type": "string"
        },
        "installPath": {
          "type": "string"
        },
        "cpu": {
          "type": "string",
          "enum": [
            "baseline",
            "modern"
          ]
        },
        "minify": {
          "type": "boolean"
        }
      },
      "required": [
        "targets",
        "builder",
        "entry"
      ],
      "additionalProperties": false
    },
    "CandidateCommandBuild": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux-x64",
              "linux-arm64",
              "linux-x64-musl",
              "linux-arm64-musl",
              "darwin-x64",
              "darwin-arm64",
              "windows-x64",
              "windows-arm64"
            ]
          }
        },
        "output": {
          "type": "string"
        },
        "binary": {
          "type": "string"
        },
        "builder": {
          "type": "string",
          "enum": [
            "command"
          ]
        },
        "run": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "targets",
        "output",
        "builder",
        "run"
      ],
      "additionalProperties": false
    },
    "CandidatePrebuiltBuild": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux-x64",
              "linux-arm64",
              "linux-x64-musl",
              "linux-arm64-musl",
              "darwin-x64",
              "darwin-arm64",
              "windows-x64",
              "windows-arm64"
            ]
          }
        },
        "output": {
          "type": "string"
        },
        "binary": {
          "type": "string"
        },
        "builder": {
          "type": "string",
          "enum": [
            "prebuilt"
          ]
        }
      },
      "required": [
        "targets",
        "output",
        "builder"
      ],
      "additionalProperties": false
    },
    "CandidateCheckPreparation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "check"
          ]
        },
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "run": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "environmentNames": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id",
        "run"
      ],
      "additionalProperties": false
    },
    "CandidateArtifactPreparation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "artifact"
          ]
        },
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "run": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "environmentNames": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "outputs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "allOf": [
                    {
                      "minLength": 1
                    }
                  ]
                },
                "path": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "archive",
                    "executable",
                    "digest",
                    "catalog-file"
                  ]
                },
                "mediaType": {
                  "type": "string",
                  "allOf": [
                    {
                      "minLength": 1
                    }
                  ]
                }
              },
              "required": [
                "id",
                "path"
              ],
              "additionalProperties": false
            }
          ],
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "allOf": [
                  {
                    "minLength": 1
                  }
                ]
              },
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "archive",
                  "executable",
                  "digest",
                  "catalog-file"
                ]
              },
              "mediaType": {
                "type": "string",
                "allOf": [
                  {
                    "minLength": 1
                  }
                ]
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "id",
        "run",
        "outputs"
      ],
      "additionalProperties": false
    },
    "CandidatePlatform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "linux",
            "darwin",
            "windows"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "libc": {
          "type": "string",
          "enum": [
            "glibc",
            "musl"
          ]
        },
        "binaryName": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "executableExtension": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "installPath": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "targetTriple": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "additionalProperties": false
    },
    "CandidateArtifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "tarball",
            "zip",
            "file",
            "directory",
            "executable",
            "binary"
          ]
        },
        "checksum": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "variant": {
          "$ref": "#/$defs/CandidatePlatform"
        }
      },
      "required": [
        "id",
        "path",
        "format"
      ],
      "additionalProperties": false
    },
    "CandidateArchive": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "nameTemplate": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tar.gz",
              "zip"
            ]
          }
        },
        "files": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "wrapInDirectory": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CandidateChecksum": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512"
          ]
        },
        "nameTemplate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CandidateContentHole": {
      "type": "object",
      "properties": {
        "fact": {
          "type": "string",
          "enum": [
            "sha256",
            "downloadUrl",
            "assetName"
          ]
        },
        "artifact": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "fact",
        "artifact"
      ],
      "additionalProperties": false
    },
    "CandidateCatalog": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "repository": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/CandidateContentHole"
                  }
                ]
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "repository",
        "file",
        "content"
      ],
      "additionalProperties": false
    },
    "CandidateNpmPublish": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "packageName": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "packagePath": {
          "type": "string"
        },
        "tokenEnv": {
          "type": "string"
        },
        "trustedPublishing": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github-actions"
              ]
            },
            "workflow": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "verifyPackageExists": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "restricted"
          ]
        },
        "provenance": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CandidateGitHubPublish": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tokenEnv": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "prerelease": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "bodyArtifact": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "CandidateHomebrew": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "url": {
          "type": "string"
        },
        "formulaName": {
          "type": "string"
        },
        "manifestName": {
          "type": "string"
        },
        "formulaPath": {
          "type": "string"
        },
        "manifestPath": {
          "type": "string"
        },
        "installPath": {
          "type": "string"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false
    },
    "CandidateScoop": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        },
        "url": {
          "type": "string"
        },
        "formulaName": {
          "type": "string"
        },
        "manifestName": {
          "type": "string"
        },
        "formulaPath": {
          "type": "string"
        },
        "manifestPath": {
          "type": "string"
        },
        "installPath": {
          "type": "string"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false
    },
    "CandidatePyPiPublish": {
      "type": "object",
      "properties": {
        "repositoryUrl": {
          "type": "string"
        },
        "pythonExecutable": {
          "type": "string"
        },
        "trustedPublishing": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "github-actions"
              ]
            },
            "workflow": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "publisherConfigured": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          },
          "additionalProperties": false
        },
        "ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "CandidatePublish": {
      "type": "object",
      "properties": {
        "npm": {
          "$ref": "#/$defs/CandidateNpmPublish"
        },
        "github": {
          "$ref": "#/$defs/CandidateGitHubPublish"
        },
        "homebrew": {
          "$ref": "#/$defs/CandidateHomebrew"
        },
        "scoop": {
          "$ref": "#/$defs/CandidateScoop"
        },
        "pypi": {
          "$ref": "#/$defs/CandidatePyPiPublish"
        }
      },
      "additionalProperties": false
    },
    "AuthoredConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/AuthoredProject"
        },
        "builds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CandidateBunBuild"
              },
              {
                "$ref": "#/$defs/CandidateCommandBuild"
              },
              {
                "$ref": "#/$defs/CandidatePrebuiltBuild"
              }
            ]
          }
        },
        "preparations": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CandidateCheckPreparation"
              },
              {
                "$ref": "#/$defs/CandidateArtifactPreparation"
              }
            ]
          }
        },
        "npmPackage": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateArtifact"
          }
        },
        "archives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateArchive"
          }
        },
        "checksum": {
          "$ref": "#/$defs/CandidateChecksum"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CandidateCatalog"
          }
        },
        "publish": {
          "$ref": "#/$defs/CandidatePublish"
        },
        "versionFrom": {
          "type": "string",
          "enum": [
            "manifest",
            "git-tag"
          ]
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    }
  }
}
