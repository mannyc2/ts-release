{
  "$schema": "https://raw.githubusercontent.com/mannyc2/ts-release/main/schema/release-config.schema.json",
  "project": {
    "name": "@scope/pkg",
    "packageName": "@scope/pkg",
    "repository": "owner/repo",
    "version": "0.1.0",
    "tag": "v0.1.0"
  },
  "npmPackage": {
    "path": "."
  },
  "publish": {
    "npm": {
      "registry": "https://registry.npmjs.org/",
      "authentication": {
        "strategy": "token",
        "credential": "NPM_TOKEN"
      },
      "access": "public",
      "provenance": "disabled"
    }
  }
}
