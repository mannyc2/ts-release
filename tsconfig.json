{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": [
      "bun-types"
    ],
    "paths": {}
  },
  "include": [
    "packages/**/*.ts",
    "test/reimplementation/**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules",
    ".repos",
    "tools",
    "docs"
  ]
}
