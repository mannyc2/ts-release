{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@mannyc1/ts-release": ["./src/index.ts"],
      "@mannyc1/ts-release/node": ["./src/platform/node.ts"],
      "@mannyc1/ts-release/bun": ["./src/platform/bun.ts"],
      "@mannyc1/ts-release/store": ["./src/store.ts"],
      "@mannyc1/ts-release/host": ["./src/host.ts"],
      "@mannyc1/ts-release/operation-journal": ["./src/operation-journal.ts"],
      "@mannyc1/ts-release/operation-journal/aws": ["./src/operation-journal/aws.ts"],
      "@mannyc1/ts-release/*": ["./src/*.ts"]
    },
    "types": ["bun-types"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", ".repos", "node_modules"]
}
